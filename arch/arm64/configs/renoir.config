# SM7350 / Xiaomi renoir (Mi 11 Lite 5G) platform fragment

CONFIG_ARCH_QCOM=y

# SM7350 clock, power and pin controllers
CONFIG_SM_GCC_7350=y
CONFIG_PINCTRL_SM7350=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_PDC=y

# CPUs / power management
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# UFS root filesystem
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# USB
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# Regulators and watchdog
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_WDT=y

# USB gadget (bring-up console over CDC-ACM)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_ROLE_SWITCH=y

# Persistent crash/boot logs (ramoops)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_COMPRESS=y

# Reboot to bootloader via PMIC SDAM restart reason
CONFIG_REBOOT_MODE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# USB2 host/OTG and gadget functions
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_ACM=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_ECM_SUBSET=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y

# PCIe / QCA6490 (WCN6855) WiFi
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH11K_DEBUG=y

# Boot splash / framebuffer console: keep kernel logs visible on the phone screen
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Stable kernel release string for module/firmware paths
CONFIG_LOCALVERSION="-renoir"
# CONFIG_LOCALVERSION_AUTO is not set
